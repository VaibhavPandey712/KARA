NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Production site URL (your Vercel domain) — required for Google OAuth redirects
# Example: https://kara.vercel.app
NEXT_PUBLIC_SITE_URL=

# Direct backend URL (optional in production if using BACKEND_URL proxy on Vercel)
# Do NOT use localhost in production builds
# Example: https://your-api.railway.app
NEXT_PUBLIC_API_URL=http://localhost:4000

# Server-only: backend URL for Next.js rewrites (set on Vercel, not exposed to browser)
# Example: https://your-api.railway.app
# BACKEND_URL=
